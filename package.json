{
  "name": "zelenyeusy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:admin": "npm run dev --workspace admin",
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "build": "npm run build --workspaces --if-present",
    "build:admin": "npm run build --workspace admin",
    "build:web": "npm run build --workspace web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:architecture && npm run test:ui && npm run test:api",
    "test:architecture": "node --test tests/*.test.js",
    "test:ui": "npm run test --workspace @site/ui",
    "test:api": "npm run test --workspace api",
    "check": "npm run lint && npm test && npm run build"
  }
}
